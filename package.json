const express = require("express");
const fs = require("fs");
const path = require("path");
const crypto = require("crypto");

const app = express();
const PORT = process.env.PORT || 3000;
const ADMIN_PASSWORD = process.env.ADMIN_PASSWORD;
if (!ADMIN_PASSWORD || ADMIN_PASSWORD.length < 12) {
  console.error("Set ADMIN_PASSWORD to a strong password of at least 12 characters before starting.");
  process.exit(1);
}

const DATA_DIR = path.join(__dirname, "data");
const DATA_FILE = path.join(DATA_DIR, "payments.json");
fs.mkdirSync(DATA_DIR, { recursive: true });
if (!fs.existsSync(DATA_FILE)) fs.writeFileSync(DATA_FILE, "[]", { mode: 0o600 });

app.disable("x-powered-by");
app.use(express.json({ limit: "12kb" }));
app.use(express.static(path.join(__dirname, "public")));

function readPayments() {
  try { return JSON.parse(fs.readFileSync(DATA_FILE, "utf8")); }
  catch { return []; }
}
function writePayments(items) {
  fs.writeFileSync(DATA_FILE, JSON.stringify(items, null, 2), { mode: 0o600 });
}
function safeEqual(a, b) {
  const aa = Buffer.from(String(a));
  const bb = Buffer.from(String(b));
  return aa.length === bb.length && crypto.timingSafeEqual(aa, bb);
}
function adminAuth(req, res, next) {
  const token = (req.headers.authorization || "").replace(/^Bearer\s+/i, "");
  if (!token || !safeEqual(token, ADMIN_PASSWORD)) return res.status(401).json({ error: "অ্যাডমিন পাসওয়ার্ড সঠিক নয়।" });
  next();
}
function clean(s, max=100) {
  return String(s || "").trim().replace(/[<>]/g, "").slice(0, max);
}

app.post("/api/payments", (req, res) => {
  const method = clean(req.body.method, 20);
  const amount = Number(req.body.amount);
  const trx = clean(req.body.trx, 80);
  const sender = clean(req.body.sender, 25);
  if (!["বিকাশ", "নগদ"].includes(method)) return res.status(400).json({ error: "পেমেন্ট মাধ্যম নির্বাচন করুন।" });
  if (!Number.isFinite(amount) || amount <= 0 || amount > 1000000) return res.status(400).json({ error: "সঠিক টাকার পরিমাণ লিখুন।" });
  if (!trx || trx.length < 4) return res.status(400).json({ error: "সঠিক Transaction ID লিখুন।" });
  const items = readPayments();
  if (items.some(p => p.trx.toLowerCase() === trx.toLowerCase())) return res.status(409).json({ error: "এই Transaction ID আগে জমা হয়েছে।" });
  const payment = {
    id: crypto.randomUUID(),
    method, amount, trx, sender,
    status: "pending",
    createdAt: new Date().toISOString(),
    reviewedAt: null
  };
  items.push(payment);
  writePayments(items);
  res.status(201).json({ message: "তথ্য জমা হয়েছে। পেমেন্ট যাচাই বাকি।", id: payment.id });
});

app.post("/api/admin/login", (req, res) => {
  if (!safeEqual(req.body.password || "", ADMIN_PASSWORD)) return res.status(401).json({ error: "পাসওয়ার্ড সঠিক নয়।" });
  res.json({ token: ADMIN_PASSWORD });
});
app.get("/api/admin/payments", adminAuth, (req, res) => {
  res.json(readPayments().sort((a,b) => b.createdAt.localeCompare(a.createdAt)));
});
app.patch("/api/admin/payments/:id", adminAuth, (req, res) => {
  const status = clean(req.body.status, 20);
  if (!["successful", "failed", "pending"].includes(status)) return res.status(400).json({ error: "অবৈধ স্ট্যাটাস।" });
  const items = readPayments();
  const index = items.findIndex(p => p.id === req.params.id);
  if (index < 0) return res.status(404).json({ error: "লেনদেন পাওয়া যায়নি।" });
  items[index].status = status;
  items[index].reviewedAt = new Date().toISOString();
  writePayments(items);
  res.json({ message: "স্ট্যাটাস আপডেট হয়েছে।" });
});

app.get("/api/health", (_req, res) => res.json({ ok: true }));
app.listen(PORT, () => console.log(`Payment app listening on port ${PORT}`));
